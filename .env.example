# Copie para .env.local e preencha somente lá. Nunca coloque chaves reais neste exemplo.
# Na Vercel: Settings → Environment Variables (mesmos nomes).

# --- Públicas (vão para o navegador) ------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Endereço público do sistema (links de convite, OAuth e webhooks). Em produção, HTTPS.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Somente servidor ----------------------------------------------------------------
# Supabase → Project Settings → API Keys → Secret keys. Convites, integrações, cron.
SUPABASE_SECRET_KEY=sb_secret_...
# 32 bytes em base64 (openssl rand -base64 32). Cifra tokens do Google, Meta e WhatsApp.
# NÃO troque depois de em uso: os tokens já gravados deixariam de abrir.
TOKEN_ENCRYPTION_KEY=
# Valor aleatório longo. Protege /api/cron/* (a Vercel envia no cabeçalho Authorization).
CRON_SECRET=

# --- Google (Agenda e Google Ads usam o mesmo cliente OAuth) ---------------------------
# Google Cloud Console → Google Auth platform → Clients → Web application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Ads: Central de API da conta gerente (MCC) → token de desenvolvedor.
GOOGLE_ADS_DEVELOPER_TOKEN=
# Opcional: ID da conta gerente (só dígitos) quando as contas são acessadas por um MCC.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Opcional: versão da API (padrão v21).
GOOGLE_ADS_API_VERSION=

# --- Meta (Meta Ads e WhatsApp Cloud API usam o mesmo app) -----------------------------
# developers.facebook.com → Seu app → Configurações → Básico.
META_APP_ID=
META_APP_SECRET=
# Opcional: versão da Graph API (padrão v23.0).
META_GRAPH_VERSION=
# Texto que você escolhe e repete no painel da Meta ao registrar o webhook do WhatsApp.
WHATSAPP_VERIFY_TOKEN=

# --- Somente para scripts/db.mjs (migrations e testes locais) --------------------------
# Supabase → Connect → Session pooler (URL postgresql:// com a SENHA do banco).
# Formato: postgresql://postgres.SEU-PROJETO:SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=
